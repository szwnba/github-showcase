---
import '../styles/global.css'
import ThemeToggle from '../components/ThemeToggle.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import { t, DEFAULT_LANG, type Lang } from '../i18n'

interface Props {
  title: string
  description?: string
  ogImage?: string
  pageLang?: Lang
}

const {
  title,
  description,
  ogImage = '/og-image.jpg',
  pageLang = DEFAULT_LANG,
} = Astro.props

const defaultDesc =
  pageLang === 'zh'
    ? 'szwnba 的采集系统 —— AI 驱动的信息采集与知识管理平台。⚡'
    : "szwnba's Collector System — An AI-driven info collection & knowledge management platform. ⚡"

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang={pageLang} data-lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>"
    />
    <meta name="theme-color" content="#1a2e1f" />
    <meta name="description" content={description ?? defaultDesc} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? defaultDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? defaultDesc} />

    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: pageLang === 'zh' ? 'szwnba 的采集系统' : "szwnba's Collector System",
      url: Astro.site?.toString() || 'https://szwnba.github.io',
      description: description ?? defaultDesc,
    })} />
  </head>
  <body>
    <div class="gradient-bg min-h-screen">
      <nav class="fixed top-0 w-full z-50 backdrop-blur-md bg-[var(--bg)]/90 border-b border-[var(--border)]">
        <div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
          <a
            href="/"
            class="flex items-center gap-2 text-xl font-semibold hover:text-[var(--accent)] transition-colors"
          >
            <span class="text-2xl">⚡</span>
            <span data-i18n="nav.home">{t('nav.home', pageLang)}</span>
          </a>

          <!-- Desktop nav links -->
          <div class="hidden md:flex items-center gap-6 text-sm sm:text-base">
            <a href="/about" class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors link-underline" data-i18n="nav.about">{t('nav.about', pageLang)}</a>
            <a href="/projects" class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors link-underline" data-i18n="nav.projects">{t('nav.projects', pageLang)}</a>
            <a href="/blog" class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors link-underline" data-i18n="nav.blog">{t('nav.blog', pageLang)}</a>
            <a href="/report" class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors link-underline" data-i18n="nav.report">{t('nav.report', pageLang)}</a>
            <a href="/todoist" class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors link-underline" data-i18n="nav.todoist">{t('nav.todoist', pageLang)}</a>
          </div>

          <!-- Shared controls (visible on all sizes) -->
          <div class="flex items-center gap-2">
            <LanguageSwitcher />
            <ThemeToggle />
            <button
              id="mobile-menu-btn"
              class="md:hidden p-2 rounded-lg border border-[var(--border)] hover:border-[var(--accent)] transition-colors"
              aria-label="Menu"
              aria-expanded="false"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="menu-icon-open">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="menu-icon-close">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile menu drawer -->
        <div id="mobile-menu" class="md:hidden hidden border-t border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur-md">
          <div class="max-w-4xl mx-auto px-6 py-4 flex flex-col gap-4 text-base">
            <a href="/about" class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors py-2" data-i18n="nav.about">{t('nav.about', pageLang)}</a>
            <a href="/projects" class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors py-2" data-i18n="nav.projects">{t('nav.projects', pageLang)}</a>
            <a href="/blog" class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors py-2" data-i18n="nav.blog">{t('nav.blog', pageLang)}</a>
            <a href="/report" class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors py-2" data-i18n="nav.report">{t('nav.report', pageLang)}</a>
            <a href="/todoist" class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors py-2" data-i18n="nav.todoist">{t('nav.todoist', pageLang)}</a>
          </div>
        </div>
      </nav>

      <main class="pt-20">
        <slot />
      </main>

      <!-- Back to top button -->
      <button
        id="back-to-top"
        class="fixed bottom-6 right-6 z-40 p-3 rounded-full bg-[var(--bg-card)] border border-[var(--border)] text-[var(--accent)] shadow-lg opacity-0 pointer-events-none transition-all duration-300 hover:border-[var(--accent)] hover:scale-110"
        aria-label="Back to top"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
        </svg>
      </button>

      <footer class="border-t border-[var(--border)] mt-20 bg-[var(--bg-darker)]">
        <div class="max-w-4xl mx-auto px-6 py-8 text-center text-[var(--text-muted)] text-sm">
          <p data-i18n="footer.madeWith">
            {pageLang === 'zh'
              ? 'szwnba 的采集系统 · Hermes Agent v0.17.0 ⚡'
              : "szwnba's Collector System · Hermes Agent v0.17.0 ⚡"}
          </p>
          <p class="mt-2 flex items-center justify-center gap-4">
            <span data-i18n="footer.rightsReserved">
              © {new Date().getFullYear()} szwnba.github.io
            </span>
            <a href="/rss.xml" class="text-[var(--accent)] hover:underline">RSS</a>
          </p>
        </div>
      </footer>
    </div>

    <script>
      // ---- Theme initialization ----
      const getInitialTheme = () => {
        const saved = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        return saved ? saved === 'dark' : prefersDark
      }
      document.documentElement.setAttribute(
        'data-theme',
        getInitialTheme() ? 'dark' : 'light'
      )

      // ---- Language initialization ----
      const getInitialLang = () => {
        const saved = localStorage.getItem('lang')
        if (saved === 'zh' || saved === 'en') return saved
        // Default to Chinese
        return 'zh'
      }
      document.documentElement.setAttribute('data-lang', getInitialLang())

      // ---- Translation dictionaries (inlined client-side) ----
      const DICT = {
        zh: {
          'nav.home': '首页',
          'nav.about': '系统',
          'nav.projects': '技能',
          'nav.blog': '知识库',
          'nav.report': '分析报告',
          'nav.todoist': '任务',
          'footer.madeWith': 'szwnba 的采集系统 · Hermes Agent v0.17.0 ⚡',
          'footer.rightsReserved': '© ' + new Date().getFullYear() + ' szwnba.github.io',
        },
        en: {
          'nav.home': 'Home',
          'nav.about': 'System',
          'nav.projects': 'Skills',
          'nav.blog': 'KB',
          'nav.report': 'Report',
          'nav.todoist': 'Tasks',
          'footer.madeWith': "szwnba's Collector System · Hermes Agent v0.17.0 ⚡",
          'footer.rightsReserved': '© ' + new Date().getFullYear() + ' szwnba.github.io',
        },
      }

      // ---- Live translation swap ----
      function applyTranslations(lang: 'zh' | 'en') {
        const dict = DICT[lang]
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = (el as HTMLElement).getAttribute('data-i18n') || ''
          if (dict[key as keyof typeof dict]) {
            el.textContent = dict[key as keyof typeof dict]
          }
        })
      }

      function getLang(): 'zh' | 'en' {
        const l = document.documentElement.getAttribute('data-lang')
        return l === 'en' ? 'en' : 'zh'
      }

      applyTranslations(getLang())

      window.addEventListener('langchange', (e: Event) => {
        const detail = (e as CustomEvent).detail
        const lang = detail?.lang || getLang()
        applyTranslations(lang)
      })

      // ---- Mobile menu toggle ----
      const menuBtn = document.getElementById('mobile-menu-btn')
      const mobileMenu = document.getElementById('mobile-menu')
      const iconOpen = document.getElementById('menu-icon-open')
      const iconClose = document.getElementById('menu-icon-close')

      menuBtn?.addEventListener('click', () => {
        const isOpen = !mobileMenu?.classList.contains('hidden')
        if (mobileMenu) mobileMenu.classList.toggle('hidden')
        iconOpen?.classList.toggle('hidden', !isOpen)
        iconClose?.classList.toggle('hidden', isOpen)
        menuBtn.setAttribute('aria-expanded', String(!isOpen))
      })

      // Close mobile menu on link click
      mobileMenu?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          mobileMenu.classList.add('hidden')
          iconOpen?.classList.remove('hidden')
          iconClose?.classList.add('hidden')
          menuBtn?.setAttribute('aria-expanded', 'false')
        })
      })

      // ---- Back to top ----
      const backBtn = document.getElementById('back-to-top')
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          backBtn?.classList.remove('opacity-0', 'pointer-events-none')
        } else {
          backBtn?.classList.add('opacity-0', 'pointer-events-none')
        }
      })
      backBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' })
      })

      // ---- Link prefetch on hover ----
      document.querySelectorAll('a[href^="/"]').forEach((a) => {
        a.addEventListener('mouseenter', () => {
          const link = a as HTMLAnchorElement
          const href = link.getAttribute('href')
          if (href && !link.dataset.prefetched) {
            const pr = document.createElement('link')
            pr.rel = 'prefetch'
            pr.href = href
            document.head.appendChild(pr)
            link.dataset.prefetched = 'true'
          }
        })
      })
    </script>
  </body>
</html>