---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { DEFAULT_LANG, type Lang } from '../../i18n'

const pageLang: Lang = DEFAULT_LANG
const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
)

// Collect all unique tags
const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))].sort()
---

<BaseLayout
  title={pageLang === 'en' ? 'Knowledge Base - szwnba Collector' : '知识库 - szwnba 采集系统'}
  description={
    pageLang === 'en'
      ? `${posts.length} articles · ${allTags.length} tags · Continuously updated knowledge base`
      : `${posts.length} 篇文章 · ${allTags.length} 个标签 · 持续更新的知识库`
  }
>
  <div class="max-w-3xl mx-auto px-6 py-12">
    <h1 class="text-4xl font-bold mb-2" data-i18n="blog.title">
      知识库 📚
    </h1>
    <p class="text-[var(--text-dim)] mb-8" data-i18n="blog.subtitle">
      {posts.length} 篇采集文章 · {allTags.length} 个标签 · 持续更新中
    </p>

    <!-- Search & Filter -->
    <div class="mb-8 space-y-4">
      <div class="relative">
        <input
          id="blog-search"
          type="text"
          placeholder="搜索文章..."
          class="w-full px-4 py-3 pl-11 bg-[var(--bg-card)] border border-[var(--border)] rounded-xl text-[var(--text)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent)] transition-colors"
          data-i18n-placeholder="blog.searchPlaceholder"
        />
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Tag filters -->
      <div id="tag-filters" class="flex flex-wrap gap-2">
        <button
          class="tag-btn active px-3 py-1.5 rounded-full text-xs font-medium border border-[var(--accent)] bg-[var(--accent-soft)] text-[var(--accent)] transition-all"
          data-tag="all"
          data-i18n="blog.allTags"
        >
          全部
        </button>
        {allTags.map((tag) => (
          <button
            class="tag-btn px-3 py-1.5 rounded-full text-xs font-medium border border-[var(--border)] text-[var(--text-dim)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all"
            data-tag={tag}
          >
            #{tag}
          </button>
        ))}
      </div>
    </div>

    <!-- Results count -->
    <p id="results-count" class="text-sm text-[var(--text-muted)] mb-4">
      共 {posts.length} 篇文章
    </p>

    <!-- Article list -->
    <div id="blog-list" class="space-y-4">
      {posts.map((post) => (
        <article
          class="blog-item p-5 bg-[var(--bg-card)] rounded-2xl border border-[var(--border)] hover:border-[var(--accent)] transition-colors card-hover"
          data-title={post.data.title.toLowerCase()}
          data-tags={(post.data.tags || []).join(',')}
        >
          <a href={`/blog/${post.slug}`} class="block">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 min-w-0">
                <h2 class="text-lg font-bold mb-1 hover:text-[var(--accent)] transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-sm text-[var(--text-dim)] line-clamp-2 mb-2">
                  {post.data.excerpt}
                </p>
                <div class="flex flex-wrap items-center gap-2">
                  <time class="text-xs text-[var(--text-muted)]">{post.data.date}</time>
                  {post.data.tags?.map((tag: string) => (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--bg-secondary)] text-[var(--text-dim)]">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>
              <svg class="w-5 h-5 text-[var(--text-muted)] flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- No results -->
    <div id="no-results" class="hidden text-center py-12 text-[var(--text-muted)]">
      <p class="text-lg mb-2">🔍</p>
      <p data-i18n="blog.noResults">没有找到匹配的文章</p>
    </div>
  </div>
</BaseLayout>

<script>
  const BLOG_DICT = {
    zh: {
      'blog.searchPlaceholder': '搜索文章...',
      'blog.allTags': '全部',
      'blog.noResults': '没有找到匹配的文章',
      'blog.resultsCount': (n: number) => `共 ${n} 篇文章`,
    },
    en: {
      'blog.searchPlaceholder': 'Search articles...',
      'blog.allTags': 'All',
      'blog.noResults': 'No matching articles found',
      'blog.resultsCount': (n: number) => `${n} articles`,
    },
  }

  function getLang(): 'zh' | 'en' {
    const l = document.documentElement.getAttribute('data-lang')
    return l === 'en' ? 'en' : 'zh'
  }

  const searchInput = document.getElementById('blog-search') as HTMLInputElement
  const blogItems = document.querySelectorAll<HTMLElement>('.blog-item')
  const noResults = document.getElementById('no-results')
  const resultsCount = document.getElementById('results-count')
  const tagBtns = document.querySelectorAll<HTMLButtonElement>('.tag-btn')

  let activeTag = 'all'
  let searchTerm = ''

  function filterPosts() {
    let visible = 0
    blogItems.forEach((item) => {
      const title = item.dataset.title || ''
      const tags = (item.dataset.tags || '').split(',').filter(Boolean)
      const matchesSearch = title.includes(searchTerm)
      const matchesTag = activeTag === 'all' || tags.includes(activeTag)
      if (matchesSearch && matchesTag) {
        item.classList.remove('hidden')
        visible++
      } else {
        item.classList.add('hidden')
      }
    })
    if (noResults) noResults.classList.toggle('hidden', visible > 0)
    if (resultsCount) {
      const lang = getLang()
      resultsCount.textContent = BLOG_DICT[lang].resultsCount(visible)
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim()
    filterPosts()
  })

  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tagBtns.forEach((b) => {
        b.classList.remove('active', 'border-[var(--accent)]', 'bg-[var(--accent-soft)]', 'text-[var(--accent)]')
        b.classList.add('border-[var(--border)]', 'text-[var(--text-dim)]')
      })
      btn.classList.add('active', 'border-[var(--accent)]', 'bg-[var(--accent-soft)]', 'text-[var(--accent)]')
      btn.classList.remove('border-[var(--border)]', 'text-[var(--text-dim)]')
      activeTag = btn.dataset.tag || 'all'
      filterPosts()
    })
  })

  // Update placeholders on lang change
  window.addEventListener('langchange', () => {
    const lang = getLang()
    const dict = BLOG_DICT[lang]
    searchInput.placeholder = dict['blog.searchPlaceholder']
    const noResultsEl = document.getElementById('no-results')?.querySelector('p[data-i18n="blog.noResults"]')
    if (noResultsEl) noResultsEl.textContent = dict['blog.noResults']
    filterPosts()
  })
</script>
